# cognitive-ecology — environment template
#
# Copy to `.env` (gitignored) or export into your shell.
# KEYS LIVE IN ENVIRONMENT VARIABLES ONLY: never in code, never in
# commits, never in docs. CI fails the build on key-shaped strings.

# --- LLM provider (DeepInfra, OpenAI-compatible) ---------------------------
# Default model is tencent/Hy4-preview (1M context; cached input ~20x
# cheaper than fresh input — see docs/06_agents_and_providers.md).
DEEPINFRA_API_KEY=
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPINFRA_MODEL=tencent/Hy4-preview
# Optional session-scoped cache key for better hit rates:
# DEEPINFRA_CACHE_KEY=my-session-1

# --- decision models (typesafe.ai-style, OpenAI-compatible) ----------------
# Point at your provider; check the current model id before use.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://openrouter.ai/api/v1
# TYPESAFE_MODEL=typesafe/jev-1.0

# --- repo bootstrap (bootstrap.sh only) -------------------------------------
# GitHub PAT with repo scope. The askpass shim keeps it in memory only.
# GITHUB_PAT=
