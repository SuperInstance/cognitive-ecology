# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# Keys are read from the environment or .env by ecology.config.

# GitHub personal access token (repo creation / pushes only — never required at runtime)
GITHUB_PAT=

# TypeSafe (Jev System One decision models) — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# MiniMax (divergent ideation panelist)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash

# DeepInfra (multi-model panel: Seed-2.0-mini devil's advocate, MiMo, Nemotron, ...)
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=ByteDance/Seed-2.0-mini
